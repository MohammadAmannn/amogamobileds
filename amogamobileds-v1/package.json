    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3"
